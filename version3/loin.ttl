# baseURI: https://w3id.org/loin
# prefix: loin

@prefix Container: <https://standards.iso.org/iso/21597/-1/ed-1/en/Container#> .
@prefix Linkset: <https://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix dt: <https://w3id.org/dt#> .
@prefix ext4loin: <https://w3id.org/loin/v3/loinext#> .
@prefix foaf: <http://xmlns.com/foaf/0.1#> .
@prefix icdd4loin: <https://w3id.org/loin/v2/icdd#> .
@prefix ids4loin: <https://w3id.org/loin/v2/ids#> .
@prefix loin: <https://w3id.org/loin#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dt:isDataTemplateFor
  owl:inverseOf loin:hasDataTemplate ;
.
<https://w3id.org/loin>
  rdf:type owl:Ontology ;
  dc:created "2023-01-30"^^xsd:date ;
  dc:creator [
      rdf:type schema:Person ;
      schema:email <mailto:liu.liu-m6r@rub.de> ;
      schema:identifier <https://orcid.org/0000-0001-5907-7609> ;
      schema:memberOf [
          schema:identifier <https://www.inf.bi.ruhr-uni-bochum.de/iib/lehrstuhl/mitarbeiter/liu_liu.html.en> ;
          schema:name "Ruhr University Bochum" ;
        ] ;
      schema:name "Liu Liu" ;
    ] ;
  dc:creator [
      rdf:type schema:Person ;
      schema:email <mailto:philipp.hagedorn-n6v@rub.de> ;
      schema:identifier <https://orcid.org/0000-0002-6249-243X> ;
      schema:memberOf [
          schema:identifier <https://www.inf.bi.ruhr-uni-bochum.de/iib/lehrstuhl/mitarbeiter/philipp_hagedorn.html.en> ;
          schema:name "Ruhr University Bochum" ;
        ] ;
      schema:name "Philipp Hagedorn" ;
    ] ;
  dc:description "The Level of Information Need (LOIN) Ontology is defined for specifying information requirements for delivery of data in a buildings' life cycle. The LOIN ontology is based on the standard ISO 7817-1 (2024). Furthermore, it is extended with vocabulary for connecing Information Delivery Specifications (IDS) and Information containers for linked document delivery (ICDD) as per ISO 21597-1 (2020). "@en ;
  dc:license <https://creativecommons.org/licenses/by/4.0/> ;
  dc:publisher [
      rdf:type schema:Organization ;
      schema:identifier <https://www.inf.bi.rub.de> ;
      schema:name "Chair of Computing in Engineering, Ruhr University Bochum" ;
      schema:parentOrganization [
          rdf:type schema:Organization ;
          schema:name "Ruhr University Bochum, Germany" ;
        ] ;
    ] ;
  dc:rights "Copyright 2023 by Chair of Computing in Engineering, Ruhr University Bochum" ;
  dc:title "Level of Information Need (LOIN) Ontology"@en ;
  vann:preferredNamespacePrefix "loin" ;
  vann:preferredNamespaceUri "https://w3id.org/loin#" ;
  owl:versionInfo "3.0" ;
.
loin:Absolute
  rdf:type loin:Location ;
  rdfs:comment "Absolute, one of the enumerations for detail according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "Absolute location"@en ;
  vs:term_status "stable" ;
.
loin:Actor
  rdf:type owl:Class ;
  rdfs:comment "Actor is part of the prerequisites according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Actor" ;
  rdfs:subClassOf owl:Thing ;
  vs:term_status "stable" ;
.
loin:AlphanumericalInformation
  rdf:type owl:Class ;
  rdfs:comment "Alphanumerical information is a term for specifying the information need according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Alphanumerical information"@en ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:notApplicable ;
    ] ;
  vs:term_status "stable" ;
.
loin:Appearance
  rdf:type owl:Class ;
  rdfs:comment "Appearance is one of the independent aspects to specify the geometrical information according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Appearance"@en ;
  rdfs:subClassOf owl:Thing ;
  owl:oneOf (
      loin:MaterialColor
      loin:NoColor
      loin:SingleColor
      loin:Textures
    ) ;
  vs:term_status "stable" ;
.
loin:BreakdownStructure
  rdf:type owl:Class ;
  rdfs:comment "Breakdown structure is a term for positioning the object in a structure according to ISO7817-1 (2024)"@en ;
  rdfs:label "Breakdown structure"@en ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:hasIdentification ;
    ] ;
  vs:term_status "stable" ;
.
loin:BreakdownStructureType
  rdf:type owl:Class ;
  rdfs:comment "Breakdown structure type is a term to specify the structure according to ISO7817-1 (2024)"@en ;
  rdfs:label "Breakdown structure type"@en ;
  rdfs:subClassOf owl:Thing ;
  vs:term_status "stable" ;
.
loin:Codification
  rdf:type loin:IdentificationType ;
  rdfs:comment "An example of identifier type from a breakdown structure according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Codification of an item in a breakdown structure"@en ;
  vs:term_status "stable" ;
.
loin:ConstructiveGeometry
  rdf:type loin:ParametricBehaviour ;
  rdfs:comment "Constructive geometry,  one of the enumerations for paratmetric behaviour according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "Constructive geometry"@en ;
  vs:term_status "stable" ;
.
loin:D0
  rdf:type loin:Dimensionality ;
  rdfs:comment "D0 reppresents the zero-dimensional, one of the enumerations for dimensionality according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "D0"@en ;
  vs:term_status "stable" ;
.
loin:D1
  rdf:type loin:Dimensionality ;
  rdfs:comment "D1 represents the one-dimensional, one of the enumerations for dimensionality according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "D1"@en ;
  vs:term_status "stable" ;
.
loin:D2
  rdf:type loin:Dimensionality ;
  rdfs:comment "D2 represents the two-dimensional, one of the enumerations for dimensionality according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "D2"@en ;
  vs:term_status "stable" ;
.
loin:D3
  rdf:type loin:Dimensionality ;
  rdfs:comment "D3 represents the three-dimensional, one of the enumerations for dimensionality according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "D3"@en ;
  vs:term_status "stable" ;
.
loin:Detail
  rdf:type owl:Class ;
  rdfs:comment "Detail one of the enumeration for appearance according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "Detail"@en ;
  rdfs:subClassOf owl:Thing ;
  owl:oneOf (
      loin:L1
      loin:L2
      loin:L3
      loin:L4
      loin:L5
    ) ;
  vs:term_status "stable" ;
.
loin:Dimensionality
  rdf:type owl:Class ;
  rdfs:comment "Dimensionality is one of the independent aspects to specify the geometrical information according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Dimensionality"@en ;
  rdfs:subClassOf owl:Thing ;
  owl:oneOf (
      loin:D0
      loin:D1
      loin:D2
      loin:D3
    ) ;
  vs:term_status "stable" ;
.
loin:DocumentContent
  rdf:type owl:Class ;
  rdfs:comment "Document content to specify the requirement document according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Document content"@en ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:definition ;
    ] ;
  vs:term_status "stable" ;
.
loin:DocumentFormat
  rdf:type owl:Class ;
  rdfs:comment "Document format to specify the requirement document according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Document format"@en ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:definition ;
    ] ;
  vs:term_status "stable" ;
.
loin:DocumentPurpose
  rdf:type owl:Class ;
  rdfs:comment "Document purpose to specify the requirement document according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Document purpose"@en ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:definition ;
    ] ;
  vs:term_status "stable" ;
.
loin:Documentation
  rdf:type owl:Class ;
  rdfs:comment "Documentation is a term for specifying the information need according to ISO7817-1 (2024)"@en ;
  rdfs:label "Documentation"@en ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:notApplicable ;
    ] ;
  vs:term_status "stable" ;
.
loin:ExplicitGeometry
  rdf:type loin:ParametricBehaviour ;
  rdfs:comment "Explicit geometry,  one of the enumerations for paratmetric behaviour according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "Explicit geometry"@en ;
  vs:term_status "stable" ;
.
loin:GeometricalInformation
  rdf:type owl:Class ;
  rdfs:comment "Geometrical information is a term for specifying the information need according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Geometrical information"@en ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:notApplicable ;
    ] ;
  vs:term_status "stable" ;
.
loin:GroupOfProperty
  rdf:type owl:Class ;
  rdfs:comment "Group of properties, a collection of properties, which have the same intended use. It builds the content of alphanumerical information according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Group of property"@en ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:name ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:hasProperty ;
    ] ;
  vs:term_status "stable" ;
.
loin:Identification
  rdf:type owl:Class ;
  rdfs:comment "Identification is used to assiging a vaule for positioning the object in a breakdown structure according to ISO7817-1 (2024)"@en ;
  rdfs:label "Identification"@en ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:belongsToBreakdownStructure ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:value ;
    ] ;
  vs:term_status "stable" ;
.
loin:IdentificationType
  rdf:type owl:Class ;
  rdfs:comment "Identification type is used to specify the identifier in a breakdown structure according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Identification type"@en ;
  rdfs:subClassOf owl:Thing ;
  owl:oneOf (
      loin:TypeName
      loin:ReferenceOfStructure
      loin:Numbering
      loin:Name
      loin:Index
      loin:Codification
    ) ;
  vs:term_status "stable" ;
.
loin:Index
  rdf:type loin:IdentificationType ;
  rdfs:comment "Index, an identifier type according to notes of ISO 7817-1 (2024)"@en ;
  rdfs:label "Index of an item in a breakdown structure"@en ;
  vs:term_status "stable" ;
.
loin:InformationDeliveryMilestone
  rdf:type owl:Class ;
  rdfs:comment "Information delivery milestone is is part of the prerequisites according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Information delivery milestone"@en ;
  rdfs:subClassOf owl:Thing ;
  vs:term_status "stable" ;
.
loin:L1
  rdf:type loin:Detail ;
  rdfs:comment "L1 represents the lowest level of detail, one of the enumerations for detail according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "L1"@en ;
  vs:term_status "stable" ;
.
loin:L2
  rdf:type loin:Detail ;
  rdfs:comment "L2, one of the enumerations for detail according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "L2"@en ;
  vs:term_status "stable" ;
.
loin:L3
  rdf:type loin:Detail ;
  rdfs:comment "L3, one of the enumerations for detail according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "L3"@en ;
  vs:term_status "stable" ;
.
loin:L4
  rdf:type loin:Detail ;
  rdfs:comment "L4, one of the enumerations for detail according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "L4"@en ;
  vs:term_status "stable" ;
.
loin:L5
  rdf:type loin:Detail ;
  rdfs:comment "L5 represents the highst level of detail, one of the enumerations for detail according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "L5"@en ;
  vs:term_status "stable" ;
.
loin:LevelOfInformationNeeds
  rdf:type owl:Class ;
  rdfs:comment "The level of information needs is the upper term for the definition of information requirements according to the LOIN concept ISO 7817-1 (2024)"@en ;
  rdfs:label "level of information needs"@en ;
  rdfs:subClassOf owl:Thing ;
  vs:term_status "stable" ;
.
loin:Location
  rdf:type owl:Class ;
  rdfs:comment "Location is one of the independent aspects to specify the geometrical information according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Location"@en ;
  rdfs:subClassOf owl:Thing ;
  owl:oneOf (
      loin:Relative
      loin:Absolute
    ) ;
  vs:term_status "stable" ;
.
loin:MaterialColor
  rdf:type loin:Appearance ;
  rdfs:comment "Material color, one of the enumerations for appearance according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "Material color"^^rdf:langString ;
  vs:term_status "stable" ;
.
loin:Name
  rdf:type loin:IdentificationType ;
  rdfs:comment "Name, an identifier type in a breakdown structure according to notes of ISO 7817-1 (2024)"@en ;
  rdfs:label "Name of an item in a breakdown structure"@en ;
  vs:term_status "stable" ;
.
loin:NoColor
  rdf:type loin:Appearance ;
  rdfs:comment "No color, one of the enumerations for appearance according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "No color" ;
  vs:term_status "stable" ;
.
loin:Numbering
  rdf:type loin:IdentificationType ;
  rdfs:comment "Numbering, an identifier type in a breakdown structure according to notes of ISO 7817-1 (2024)"@en ;
  rdfs:label "Numbering of an item in a breakdown structure" ;
  vs:term_status "stable" ;
.
loin:ObjectType
  rdf:type owl:Class ;
  rdfs:comment "ObjectType is used to identify and generalise objects within a breakdown structure according to the alignment with the Product Data Template for alphanumeric information in the LOIN concept (2024)"@en ;
  rdfs:label "ObjectType"@en ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:hasIdentification ;
    ] ;
  vs:term_status "stable" ;
.
loin:ParametricBehaviour
  rdf:type owl:Class ;
  rdfs:comment "Parametric behaviour is one of the independent aspects to specify the geometrical information according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Parametric behaviour"@en ;
  rdfs:subClassOf owl:Thing ;
  owl:oneOf (
      loin:ParametricGeometry
      loin:ExplicitGeometry
      loin:ConstructiveGeometry
    ) ;
  vs:term_status "stable" ;
.
loin:ParametricGeometry
  rdf:type loin:ParametricBehaviour ;
  rdfs:comment "Parametric geometry, one of the enumerations for paratmetric behaviour according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "Parametric geometry"@en ;
  vs:term_status "stable" ;
.
loin:Prerequisites
  rdf:type owl:Class ;
  rdfs:comment "Prerequisites provide contextual information of a specification definition. It is used to summarise the purpose, delivery milestones, actors and objects according to the LOIN concept (2024)"@en ;
  rdfs:label "Prerequisites"@en ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:hasInformationDeliveryMilestone ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:hasPurpose ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:hasReceivingActor ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:hasSendingActor ;
    ] ;
  vs:term_status "stable" ;
.
loin:Property
  rdf:type owl:Class ;
  rdfs:comment "Property, a content of alphanumerical information according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Property"@en ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:datatype ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:name ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:unit ;
    ] ;
  vs:term_status "stable" ;
.
loin:Purpose
  rdf:type owl:Class ;
  rdfs:comment "Purpose is part of the prerequisites according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Purpose" ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:description ;
    ] ;
.
loin:ReceivingActor
  rdf:type owl:Class ;
  rdfs:comment "Receiving actor is a party for information delivery according to ISO 19650-1 (2018)"@en ;
  rdfs:label "Receiving actor"@en ;
  rdfs:subClassOf loin:Actor ;
  vs:term_status "stable" ;
.
loin:ReferenceOfStructure
  rdf:type loin:IdentificationType ;
  rdfs:comment "Reference, an identifier type in a breakdown structure according to notes of ISO 7817-1 (2024)"@en ;
  rdfs:label "Reference of an item in a breakdown structure"@en ;
  vs:term_status "stable" ;
.
loin:Relative
  rdf:type loin:Location ;
  rdfs:comment "Relative, one of the enumerations for Location according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "Relative location"@en ;
  vs:term_status "stable" ;
.
loin:RequiredDocument
  rdf:type owl:Class ;
  rdfs:comment "Document is a term for specifying the documentation of information need according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Document"@en ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty icdd4loin:isRelatedToContainerDocument ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty icdd4loin:isRelatedToContainerLinkset ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty loin:hasDocumentPurpose ;
      owl:someValuesFrom loin:DocumentContent ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty loin:hasDocumentPurpose ;
      owl:someValuesFrom loin:DocumentFormat ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty loin:hasDocumentPurpose ;
      owl:someValuesFrom loin:DocumentPurpose ;
    ] ;
  vs:term_status "stable" ;
.
loin:SendingActor
  rdf:type owl:Class ;
  rdfs:comment "Sending actor is a party for information delivery according to ISO 19650-1 (2018)"@en ;
  rdfs:label "Sending actor"@en ;
  rdfs:subClassOf loin:Actor ;
  vs:term_status "stable" ;
.
loin:SingleColor
  rdf:type loin:Appearance ;
  rdfs:comment "realistic, one of the enumerations for appearance according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "Single color"@en ;
  vs:term_status "stable" ;
.
loin:Specification
  rdf:type owl:Class ;
  rdfs:comment "The specification contains the prerequisites and the detail informatin requirements definition according to the LOIN concept ISO 7817-1 (2024)"@en ;
  rdfs:label "specification of loin"@en ;
  rdfs:subClassOf owl:Thing ;
  vs:term_status "stable" ;
.
loin:SpecificationPerObjectType
  rdf:type owl:Class ;
  rdfs:comment "SpecificationPerObjectType is a contextual aspect according to ISO 7817-1 (2024)"@en ;
  rdfs:label "Specification per Object Type"@en ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty loin:isSpecifiedForObjectType ;
    ] ;
  vs:term_status "stable" ;
.
loin:Textures
  rdf:type loin:Appearance ;
  rdfs:comment "Textures, one of the enumerations for appearance according to the geometrical information specification for information need in ISO 7817-1 (2024)"@en ;
  rdfs:label "Textures"@en ;
  vs:term_status "stable" ;
.
loin:TypeName
  rdf:type loin:IdentificationType ;
  rdfs:comment "Type name, an identifier type in a breakdown structure according to notes of ISO 7817-1 (2024)"@en ;
  rdfs:label "Type name of an item in a breakdown structure"@en ;
  vs:term_status "stable" ;
.
loin:belongsToBreakdownStructure
  rdf:type owl:ObjectProperty ;
  rdfs:comment "The object property relates the identifier of the object type with a breakdown structure according to ISO 7817-1 (2024)"@en ;
  rdfs:domain loin:Identification ;
  rdfs:label "has breakdown structure"@en ;
  rdfs:range loin:BreakdownStructure ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  vs:term_status "stable" ;
.
loin:containsObjectType
  rdf:type owl:ObjectProperty ;
  rdfs:comment "The object property relates the object type itself to summarize the sub objecttypes according to ISO 7817-1 (2024)"@en ;
  rdfs:domain loin:ObjectType ;
  rdfs:label "contains ObjectType"@en ;
  rdfs:range loin:ObjectType ;
