icdd4loin:OntologyDataDefinition
  rdf:type owl:Class ;
  rdfs:comment "Ontology data definition is an extension of ISO7817-1 (2024). It is used to specify the alphanumerical information according to a published or customized ontology"@en ;
  rdfs:label "Ontology-based requirement definition"@en ;
  rdfs:subClassOf ext4loin:InformationContent ;
  vs:term_status "stable" ;
.
icdd4loin:belongsToInformationContent
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Specification of document, that relates with a respective information content, which can be specified as geometrical, alphanumerical information"@en ;
  rdfs:domain loin:RequiredDocument ;
  rdfs:label "belongs to information content"@en ;
  rdfs:range loin:AlphanumericalInformation ;
  rdfs:range loin:GeometricalInformation ;
  rdfs:range loin:GroupOfProperty ;
  rdfs:range loin:Property ;
  owl:inverseOf icdd4loin:isRelatedToLoinDocument ;
  vs:term_status "stable" ;
.
icdd4loin:isRelatedToContainerDescription
  rdf:type owl:ObjectProperty ;
  rdfs:comment "The object property is an extension with ICDD. It relates the information delivery milestone defined by BS EN 17412-1(2020) with container description"@en ;
  rdfs:domain loin:InformationDeliveryMilestone ;
  rdfs:domain loin:Purpose ;
  rdfs:label "is related to container description"@en ;
  rdfs:range Container:ContainerDescription ;
  vs:term_status "stable" ;
.
icdd4loin:isRelatedToContainerDocument
  rdf:type owl:ObjectProperty ;
  rdf:type owl:SymmetricProperty ;
  rdfs:comment "The object property is an extension with ICDD. It relates documents defined by ISO7817-1 (2024) with container payload documents"@en ;
  rdfs:domain loin:RequiredDocument ;
  rdfs:label "is related to container document"@en ;
  rdfs:range Container:Document ;
  vs:term_status "stable" ;
.
icdd4loin:isRelatedToContainerLinkset
  rdf:type owl:ObjectProperty ;
  rdfs:comment "The object property is an extension with ICDD. It relates document using RDF-based format with container linkset or date triples"@en ;
  rdfs:domain loin:RequiredDocument ;
  rdfs:label "is related to container linkset"@en ;
  rdfs:range Container:Linkset ;
  vs:term_status "stable" ;
.
icdd4loin:isRelatedToContainerParty
  rdf:type owl:ObjectProperty ;
  rdfs:comment "The object property is an extension with ICDD. It relates the actors defined by ISO7817-1(2024) with container party"@en ;
  rdfs:domain loin:Actor ;
  rdfs:label "is related to container party"@en ;
  rdfs:range Container:Party ;
  vs:term_status "stable" ;
.
icdd4loin:isRelatedToLinksetIdentifier
  rdf:type owl:ObjectProperty ;
  rdfs:comment "The object property is an extension with ICDD. It relates the identifier type defined by ISO 7817-1(2024) with linkset identifier"@en ;
  rdfs:domain loin:IdentificationType ;
  rdfs:label "is related to linkset identifier"@en ;
  rdfs:range Linkset:Identifier ;
  vs:term_status "stable" ;
.
icdd4loin:isRelatedToLoinDocument
  rdf:type owl:ObjectProperty ;
  rdfs:comment "The object property relates the alphanumerical information content with document according to ISO7817-1(2024)"@en ;
  rdfs:domain loin:AlphanumericalInformation ;
  rdfs:domain loin:GeometricalInformation ;
  rdfs:domain loin:GroupOfProperty ;
  rdfs:domain loin:Property ;
  rdfs:domain ext4loin:InformationContent ;
  rdfs:label "is related to required document defined in loin" ;
  rdfs:range loin:RequiredDocument ;
  owl:inverseOf icdd4loin:belongsToInformationContent ;
  vs:term_status "stable" ;
.
ext4loin:InformationContent
  rdf:type owl:Class ;
  rdfs:comment "Proxy element for additional content to specify alphanumerical information"@en ;
