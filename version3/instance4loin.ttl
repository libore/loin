.
instance4loin:Doc_Specification
  rdf:type loin:DocumentContent ;
  rdfs:comment "Documents such as technical specifications according to notes according to notes of ISO 7817-1 (2024)"@en ;
  rdfs:label "Specification"@en ;
  vs:term_status "stable" ;
.
